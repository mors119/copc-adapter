{
  "name": "@frillab/copc-adapter",
  "version": "0.7.1",
  "type": "module",
  "description": "Stream and visualize COPC point clouds directly in CesiumJS and Three.js.",
  "keywords": [
    "copc",
    "point-cloud",
    "lidar",
    "cesium",
    "cesiumjs",
    "three",
    "threejs",
    "webgl"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mors119/copc-adapter.git",
    "directory": "packages/adapter"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./cesium": {
      "types": "./dist/cesium.d.ts",
      "import": "./dist/cesium.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/samples",
    "!dist/samples/**",
    "!dist/**/*.copc.laz"
  ],
  "scripts": {
    "build": "npm run build:library",
    "clean:library": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:library": "npm run clean:library && npm run prepare-library-assets && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/fix-declaration-specifiers.mjs && npm run finalize-library-assets",
    "build:library:ci": "npm run clean:library && node ../../scripts/copy-laz-perf.mjs && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/fix-declaration-specifiers.mjs && npm run finalize-library-assets",
    "prepack": "npm run build:library",
    "typecheck": "tsc --noEmit",
    "benchmark:renderer": "node --import tsx scripts/renderer-performance-benchmark.mjs",
    "benchmark:cache-representations": "node --expose-gc --import tsx scripts/cache-representation-performance-benchmark.mjs",
    "benchmark:vertical-grid": "node --expose-gc --import tsx scripts/vertical-grid-performance-benchmark.mjs",
    "benchmark:three-renderer": "node --import tsx scripts/three-renderer-performance-benchmark.mjs",
    "test": "npm run prepare-copc-adapter-wasm && node scripts/run-tests.mjs",
    "test:raw": "node scripts/run-tests.mjs",
    "test:file": "node scripts/run-tests.mjs --single",
    "test:conformance:unit": "npm run prepare-copc-adapter-wasm && node scripts/run-tests.mjs --skip-integration test/core/copc/backend/conformance.test.mjs",
    "test:conformance:integration": "npm run prepare-copc-adapter-wasm && node scripts/run-tests.mjs test/core/copc/backend/conformance.test.mjs",
    "coverage": "npm run prepare-copc-adapter-wasm && node scripts/run-tests.mjs --coverage",
    "coverage:raw": "node scripts/run-tests.mjs --coverage",
    "prepare-copc-adapter-wasm": "node scripts/build-copc-adapter-wasm.mjs",
    "prepare-library-assets": "npm run prepare-copc-adapter-wasm && node ../../scripts/copy-laz-perf.mjs",
    "finalize-library-assets": "node scripts/finalize-library-assets.mjs"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.2",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "cesium": "^1.142.0",
    "three": "^0.186.0",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "copc": "^0.0.9",
    "proj4": "^2.20.9"
  },
  "peerDependencies": {
    "cesium": ">=1.142.0",
    "three": ">=0.170.0"
  },
  "peerDependenciesMeta": {
    "cesium": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  }
}
