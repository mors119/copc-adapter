{
  "name": "@mors119/copc-cesium",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "npm run prepare-assets && vite",
    "build": "tsc && npm run prepare-assets && vite build",
    "build:library": "tsc -p tsconfig.lib.json && vite build --config vite.lib.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run prepare-copc-wasm && node --import tsx --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "coverage": "npm run prepare-copc-wasm && node --import tsx --test --experimental-test-coverage test/*.test.mjs",
    "preview": "vite preview",
    "prepare-assets": "npm run prepare-copc-wasm && npm run prepare-laz-perf",
    "prepare-copc-wasm": "node scripts/build-copc-wasm.mjs",
    "prepare-laz-perf": "cp node_modules/laz-perf/lib/laz-perf.wasm public/laz-perf.wasm"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.2",
    "@playwright/test": "^1.55.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-cesium": "^1.2.23",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "dependencies": {
    "cesium": "^1.142.0",
    "copc": "^0.0.8",
    "proj4": "^2.20.9"
  }
}
