{
  "name": "@frillab/copc-adapter-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:unit": "node --experimental-strip-types --test test/*.test.mjs ../shared/schema/test/*.test.mjs ../shared/config/test/*.test.mjs ../shared/codegen/test/*.test.mjs ../shared/diagnostics/test/*.test.mjs ../shared/inspection/test/*.test.mjs ../shared/workbench/test/*.test.mjs",
    "test:provenance": "node --test test/package-provenance.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "build": "vite build && node scripts/relocate-cesium-assets.mjs && node scripts/assert-build.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@frillab/copc-adapter": "0.7.1",
    "@playwright/test": "^1.64.1",
    "@types/three": "^0.186.0",
    "cesium": "^1.142.0",
    "three": "^0.186.0",
    "typescript": "~7.0.2",
    "vite": "^8.0.12",
    "vite-plugin-cesium": "^1.2.23"
  }
}
