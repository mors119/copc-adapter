{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@frillab/copc-adapter": ["../../packages/adapter/index.ts"],
      "@frillab/copc-adapter/cesium": ["../../packages/adapter/cesium.ts"],
      "@frillab/copc-adapter/three": ["../../packages/adapter/three.ts"]
    }
  },
  "include": ["src", "../../packages/adapter/core/types/**/*.d.ts"]
}
